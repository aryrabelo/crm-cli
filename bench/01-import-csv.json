{
  "name": "import-135-csv",
  "description": "Load a 135-row, 8-column lead list into the CRM.",
  "setup": {},
  "batch": {
    "steps": [
      {"tool": "crm_table_import", "args": {"table": "leads", "key": "email", "csv": "{{file:fixtures/people_135.csv}}"}}
    ],
    "checks": [
      {"sql": "SELECT COUNT(*) FROM workspace_rows", "equals": 135},
      {"result": -1, "path": "failed", "equals": 0}
    ]
  },
  "per_entity": {
    "steps": [
      {"foreach": "fixtures/people_135.csv", "calls": [
        {"tool": "crm_person_create", "args": {"first_name": "{{row.first_name}}", "last_name": "{{row.last_name}}",
          "email": "{{row.email}}", "company": "{{row.company}}", "title": "{{row.title}}", "location": "{{row.city}}",
          "notes": "{{row.description}}"}}
      ]}
    ],
    "checks": [
      {"sql": "SELECT COUNT(*) FROM people WHERE archived = 0", "equals": 135}
    ]
  }
}
