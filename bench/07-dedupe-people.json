{
  "name": "find-dedupe-people",
  "description": "Turn 40 lead rows into people: 30 are unique, 10 repeat an email in upper case (5 also lower-case the first name).",
  "setup": {
    "table": {"name": "leads", "csv": "fixtures/dupes_40.csv"}
  },
  "batch": {
    "steps": [
      {"tool": "crm_push_dedupe", "args": {"table": "leads", "to": "person", "dedupe": "email"}}
    ],
    "checks": [
      {"sql": "SELECT COUNT(*) FROM people WHERE archived = 0", "equals": 30},
      {"result": -1, "path": "merged", "equals": 10}
    ]
  },
  "per_entity": {
    "steps": [
      {"foreach": "fixtures/dupes_40.csv", "calls": [
        {"tool": "crm_person_create", "allow_error": true, "args": {"first_name": "{{row.first_name}}",
          "last_name": "{{row.last_name}}", "email": "{{row.email}}", "company": "{{row.company}}"}}
      ]}
    ],
    "checks": [
      {"sql": "SELECT COUNT(*) FROM people WHERE archived = 0", "equals": 30}
    ]
  }
}
